// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  STAFF
  USER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  PENDING_DELETION
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TenantMembershipStatus {
  ACTIVE
  REVOKED
  SUSPENDED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  // Legacy plaintext API key retained temporarily for lazy migration only.
  apiKey          String?   @unique
  apiKeyHash      String?   @unique
  apiKeyPrefix    String?
  apiKeyCreatedAt DateTime?
  apiKeyLastUsedAt DateTime?
  emailVerified Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                   Session[]
  webhooks                   Webhook[]
  notifications              Notification[]
  sessionAccesses            SessionAccess[]
  oauthClients               OAuthClient[]               @relation("OAuthClientCreator")
  oauthGrants                OAuthGrant[]
  oauthAuthorizationRequests OAuthAuthorizationRequest[]
  oauthAuthorizationCodes    OAuthAuthorizationCode[]
  oauthAccessTokens          OAuthAccessToken[]
  oauthRefreshTokens         OAuthRefreshToken[]
  oidcIdentities             OIDCIdentity[]
  emailVerificationTokens    EmailVerificationToken[]
  tenantMemberships          TenantMembership[]
  resourceGrantsPrincipal    ResourceGrant[] @relation("ResourceGrantPrincipal")
  resourceGrantsGranted      ResourceGrant[] @relation("ResourceGrantGrantedBy")
  apiCredentials             ApiCredential[]
  auditEvents                AuditEvent[] @relation("AuditEventActor")
  adminAccessEvents          AdminAccessEvent[] @relation("AdminAccessEventActor")
}

model Tenant {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  status         TenantStatus @default(ACTIVE)
  suspendedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships                 TenantMembership[]
  invitations                 TenantInvitation[]
  settings                    TenantSettings?
  resourceGrants              ResourceGrant[]
  apiCredentials              ApiCredential[]
  auditEvents                 AuditEvent[]
  adminAccessEvents           AdminAccessEvent[]
  sessions                    Session[]
  messages                    Message[]
  contacts                    Contact[]
  groups                      Group[]
  stories                     Story[]
  labels                      Label[]
  chatLabels                  ChatLabel[]
  authStates                  AuthState[]
  botConfigs                  BotConfig[]
  autoReplies                 AutoReply[]
  scheduledMessages           ScheduledMessage[]
  webhooks                    Webhook[]
  webhookLogs                 WebhookLog[]
  inboundEvents               InboundEvent[]
  processingResults           ProcessingResult[]
  broadcastLogs               BroadcastLog[]
  broadcastRecipients         BroadcastRecipient[]
  outboundMessageOperations   OutboundMessageOperation[]
  oauthClients                OAuthClient[]
  oauthAuthorizationRequests  OAuthAuthorizationRequest[]
  oauthAuthorizationCodes     OAuthAuthorizationCode[]
  oauthAccessTokens           OAuthAccessToken[]
  oauthRefreshTokens          OAuthRefreshToken[]
  oauthGrants                 OAuthGrant[]
  oauthGrantCapabilities      OAuthGrantSessionCapability[]
  whatsappSessionLeases       WhatsAppSessionLease[]
  whatsappSendThrottles       WhatsAppSendThrottle[]
  notifications               Notification[]
  sessionAccesses             SessionAccess[]
}

model TenantMembership {
  id                String                   @id @default(cuid())
  tenantId          String
  userId            String
  role              TenantRole               @default(MEMBER)
  status            TenantMembershipStatus   @default(ACTIVE)
  joinedAt          DateTime                 @default(now())
  revokedAt         DateTime?
  membershipVersion Int                      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model TenantInvitation {
  id         String     @id @default(cuid())
  tenantId   String
  email      String
  role       TenantRole @default(MEMBER)
  tokenHash  String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tenantId, expiresAt, revokedAt])
}

model TenantSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  displayName        String?
  timezone           String?
  locale             String?
  branding           Json?
  registrationPolicy Json?
  retentionPolicy    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ResourceGrant {
  id              String   @id @default(cuid())
  tenantId        String
  resourceType    String
  resourceId      String
  principalUserId String?
  capabilities    Json
  grantedBy       String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  principalUser User?  @relation("ResourceGrantPrincipal", fields: [principalUserId], references: [id], onDelete: SetNull)
  granter       User?  @relation("ResourceGrantGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, principalUserId])
  @@index([tenantId, revokedAt, expiresAt])
}

model ApiCredential {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  name       String
  keyHash    String   @unique
  keyPrefix  String
  scopes     Json?
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, revokedAt, expiresAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  tenantId    String?
  action      String
  reason      String?  @db.Text
  resourceType String?
  resourceId  String?
  requestId   String?
  outcome     String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor  User?   @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
}

model AdminAccessEvent {
  id          String   @id @default(cuid())
  actorUserId String
  tenantId    String?
  action      String
  reason      String   @db.Text
  resourceType String?
  resourceId  String?
  requestId   String?
  outcome     String
  createdAt   DateTime @default(now())

  actor  User    @relation("AdminAccessEventActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
}

model Session {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  name      String // e.g. "Marketing WA"
  sessionId String   @unique // The unique ID used for Baileys auth
  status    String   @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ZOMBIE
  qr        String?  @db.Text
  config    Json? // Store instance specific config (e.g. "read_receipts": true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts          Contact[]
  messages          Message[]
  groups            Group[]
  autoReplies       AutoReply[]
  stories           Story[]
  scheduledMessages ScheduledMessage[]
  webhooks          Webhook[]
  inboundEvents     InboundEvent[]
  processingResults ProcessingResult[]
  botConfig         BotConfig?
  sessionAccesses   SessionAccess[]
  oauthGrantCapabilities OAuthGrantSessionCapability[]

  @@index([tenantId, userId])
}

model Contact {
  id           String   @id @default(cuid())
  tenantId     String?
  sessionId    String
  jid          String // remoteJid (123456@s.whatsapp.net)
  lid          String? // LID JID
  name         String?
  notify       String? // Pushname
  verifiedName String? // Business Name
  remoteJidAlt String? // Alternate JID (e.g. Phone if JID is LID)
  profilePic   String?  @db.Text
  data         Json? // Detailed contact data
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([sessionId, jid])
  @@index([tenantId, sessionId, jid])
}

model Message {
  id        String        @id @default(cuid())
  tenantId  String?
  sessionId String
  remoteJid String // Receiver or Group Jid
  senderJid String? // If group, who sent it. If private, same as remoteJid (incoming) or me (outgoing)
  fromMe    Boolean
  keyId     String // WhatsApp Message Key ID
  pushName  String?
  type      MessageType   @default(TEXT)
  content   String?       @db.Text // Text content or Caption
  mediaUrl  String?       @db.Text // Path to file if media
  status    MessageStatus @default(PENDING)
  timestamp DateTime      @default(now())

  quoteId String? // For replies

  contactId String?
  contract  Contact? @relation(fields: [contactId], references: [id])
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inboundEvents InboundEvent[]
  processingResults ProcessingResult[]

  @@unique([sessionId, keyId])
  @@index([tenantId, sessionId, remoteJid])
  @@index([tenantId, sessionId, remoteJid, timestamp])
  @@index([sessionId, remoteJid])
  @@index([sessionId, remoteJid, timestamp])
}

model Group {
  id           String    @id @default(cuid())
  tenantId     String?
  sessionId    String
  jid          String
  subject      String?
  description  String?   @db.Text
  ownerJid     String?
  participants Json? // Stored as JSON for now: [{id: '123@s.whatsapp.net', admin: 'admin' | null}]
  creation     DateTime?
  restrict     Boolean? // Only admins can edit group info
  announce     Boolean? // Only admins can send messages

  metadata Json? // Raw full metadata dump

  inviteCode String?

  // Community Features
  isCommunity     Boolean @default(false)
  linkedParentJid String? // JID of the community parent group if it belongs to one

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
  @@index([tenantId, sessionId, jid])
}

model AutoReply {
  id          String   @id @default(cuid())
  tenantId    String?
  sessionId   String
  keyword     String
  matchType   String // EXACT, CONTAINS, REGEX
  response    String?  @db.Text
  isMedia     Boolean  @default(false)
  mediaUrl    String?
  mediaType   String?
  triggerType String   @default("ALL") // ALL, GROUP, PRIVATE
  createdAt   DateTime @default(now())

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId, keyword])
}

model Story {
  id        String   @id @default(cuid())
  tenantId  String?
  sessionId String
  jid       String // User who posted the story or Broadcast JID
  content   String?  @db.Text
  mediaUrl  String?  @db.Text
  type      String // IMAGE, VIDEO, TEXT
  timestamp DateTime @default(now())
  viewed    Boolean  @default(false)

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId, timestamp])
}

model ScheduledMessage {
  id             String   @id @default(cuid())
  tenantId       String?
  sessionId      String
  jid            String
  content        String?  @db.Text
  mediaUrl       String?
  mediaType      String? // image, video, document, etc.
  sendAt         DateTime
  cronExpression String? // e.g., '*/5 * * * *'
  recurrenceRule String?  @db.Text // UI JSON state
  status         String   @default("PENDING") // PENDING, SENT, FAILED
  claimToken     String?
  claimedAt      DateTime?
  attempts       Int      @default(0)
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, sendAt])
  @@index([tenantId, status, claimedAt])
  @@index([status, sendAt])
  @@index([status, claimedAt])
}

// Store for Baileys MultiFileAuthState (in DB)
model AuthState {
  id        String @id @default(cuid())
  tenantId  String?
  sessionId String
  key       String // Filename/Key (creds.json, etc)
  value     Json

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([sessionId, key])
  @@index([tenantId, sessionId, key])
}

// Webhook configuration for external event notifications
model Webhook {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  sessionId String? // Optional: specific session, null = all sessions
  name      String // e.g. "My Server Webhook"
  url       String // The webhook endpoint URL
  allowLocal Boolean  @default(false)
  requestHeaders String?  @db.Text
  secret    String? // Optional secret for HMAC signing
  events    Json // Array of event types: ["message.received", "message.sent", "connection.update", etc.]
  filters   Json? // Optional advanced delivery filters; null preserves legacy behavior
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs    WebhookLog[]

  @@index([tenantId, userId])
  @@index([tenantId, sessionId])
}

// Webhook delivery logs — tracks every webhook request attempt
model WebhookLog {
  id                 String   @id @default(cuid())
  tenantId           String?
  webhookId          String
  event              String // The event that triggered this webhook
  status             String // SUCCESS, FAILED
  requestUrl         String   @db.Text
  requestHeaders     Json?
  requestBody        Json?
  responseStatusCode Int?
  responseBody       String?  @db.Text
  responseTimeMs     Int?
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId, webhookId, createdAt])
  @@index([webhookId])
  @@index([webhookId, createdAt])
}

// Durable receipt for inbound WhatsApp events. This is intentionally separate
// from WebhookLog: one inbound event can fan out to many webhook destinations.
model InboundEvent {
  id                String    @id @default(cuid()) @db.VarChar(191)
  tenantId          String?
  eventId           String    @unique @db.VarChar(191)
  eventType         String    @db.VarChar(64)
  sessionId         String    @db.VarChar(191)
  originalMessageId String    @db.VarChar(191)
  payloadHash       String    @db.Char(64)
  payload           Json
  status            String    @default("RECEIVED") @db.VarChar(32)
  attempts          Int       @default(0)
  availableAt       DateTime  @default(now())
  claimToken        String?   @db.VarChar(191)
  claimExpiresAt    DateTime?
  jobId             String?   @db.VarChar(191)
  resultId          String?   @db.VarChar(191)
  messageId         String?   @db.VarChar(191)
  mediaRef          String?   @db.Text
  lastError         String?   @db.Text
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  result  ProcessingResult? @relation(fields: [resultId], references: [resultId], onDelete: SetNull)

  @@unique([sessionId, eventType, originalMessageId], map: "inbound_event_source_uq")
  @@index([tenantId, sessionId, receivedAt])
  @@index([status, availableAt], map: "inbound_event_queue_idx")
  @@index([sessionId, receivedAt], map: "inbound_event_session_idx")
  @@index([jobId], map: "inbound_event_job_idx")
  @@index([resultId], map: "inbound_event_result_idx")
  @@index([messageId], map: "inbound_event_message_idx")
}

// Durable versioned output produced by a local or remote processing worker.
// The sessionId relation is the database session authority; sessionPublicId
// preserves the public WhatsApp session identifier carried by the contract.
model ProcessingResult {
  id              String   @id @default(cuid()) @db.VarChar(191)
  tenantId        String?  @db.VarChar(191)
  resultId        String   @unique @db.VarChar(191)
  contractVersion String   @db.VarChar(64)
  eventId         String   @db.VarChar(191)
  jobId           String   @db.VarChar(191)
  correlationId   String   @db.VarChar(191)
  sessionId       String   @db.VarChar(191)
  sessionPublicId String   @db.VarChar(191)
  messageId       String?  @db.VarChar(191)
  modality        String   @db.VarChar(32)
  processorVersion String  @db.VarChar(128)
  status          String   @db.VarChar(32)
  language        String?  @db.VarChar(32)
  text            String?  @db.Text
  evidence        Json
  confidence      Float?
  sourceReferences Json
  artifacts       Json
  accessScope     Json
  failureReason   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  inboundEvents InboundEvent[]

  @@unique([eventId, jobId], map: "processing_result_event_job_uq")
  @@index([tenantId, sessionId, status, createdAt])
  @@index([tenantId, sessionPublicId, createdAt])
  @@index([sessionId, status, createdAt], map: "processing_result_session_status_idx")
  @@index([sessionId, modality, createdAt], map: "processing_result_session_modality_idx")
  @@index([sessionPublicId, createdAt], map: "processing_result_public_session_idx")
}

enum AccessMode {
  ALL
  OWNER
  SPECIFIC
  BLACKLIST
}

model BotConfig {
  id        String  @id @default(cuid())
  tenantId  String?
  sessionId String  @unique
  enabled   Boolean @default(true)

  // Bot Command Access
  botName        String     @default("WA-AKG Bot")
  botMode        AccessMode @default(OWNER)
  botAllowedJids Json? // Array of JIDs ["628123@s.whatsapp.net"]
  botBlockedJids Json? // Array of JIDs ["628123@s.whatsapp.net"] for BLACKLIST mode

  // Auto Reply Access
  autoReplyMode        AccessMode @default(ALL)
  autoReplyAllowedJids Json?
  autoReplyBlockedJids Json? // Array of JIDs for BLACKLIST mode

  enableSticker      Boolean @default(true)
  enableVideoSticker Boolean @default(true)
  maxStickerDuration Int     @default(10) // in seconds
  enablePing         Boolean @default(true)
  enableUptime       Boolean @default(true)
  removeBgApiKey     String?
  prefix             String  @default("#")

  // Anti-Spam / Rate Limit
  antiSpamEnabled Boolean @default(false)
  spamLimit       Int     @default(5) // Messages allowed in window
  spamInterval    Int     @default(10) // Seconds window
  spamDelayMin    Int     @default(1000) // MS min delay
  spamDelayMax    Int     @default(3000) // MS max delay

  // Automation & Presence
  welcomeMessage String? @db.Text
  autoRead       Boolean @default(false)
  alwaysOnline   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
}

model SystemConfig {
  id                 String  @id @default("default") // Singleton ID
  appName            String  @default("WA-AKG")
  logoUrl            String?
  faviconUrl         String?
  timezone           String  @default("Asia/Jakarta")
  enableRegistration Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// Labels/Tags for organizing chats
model Label {
  id        String   @id @default(cuid())
  tenantId  String?
  sessionId String
  name      String
  color     Int      @default(0) // 0-19 for WhatsApp color codes
  colorHex  String   @default("#FF0000") // Hex representation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  chatLabels ChatLabel[]

  @@unique([sessionId, name]) // Unique label name per session
  @@index([tenantId, sessionId])
  @@index([sessionId])
}

// Many-to-many relationship between chats and labels
model ChatLabel {
  id        String   @id @default(cuid())
  tenantId  String?
  labelId   String
  chatJid   String // The JID of the chat
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  label Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([labelId, chatJid]) // Prevent duplicate label assignments
  @@index([tenantId, labelId, chatJid])
  @@index([chatJid])
  @@index([labelId])
}

model Notification {
  id      String  @id @default(cuid())
  tenantId String?
  userId  String
  title   String
  message String  @db.Text
  type    String  @default("INFO") // INFO, WARNING, SUCCESS, SYSTEM
  read    Boolean @default(false)
  href    String?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
}

// Shared session access — allows session owners to grant access to other users
model SessionAccess {
  id        String   @id @default(cuid())
  tenantId  String?
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([tenantId, sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

model OAuthClient {
  id               String    @id @default(cuid())
  tenantId         String?
  clientId         String    @unique
  clientSecretHash String?
  name             String
  description      String?   @db.Text
  redirectUris     Json
  allowedScopes    Json
  grantTypes       Json
  isConfidential   Boolean   @default(true)
  isActive         Boolean   @default(true)
  createdById      String?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant                Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy             User?                       @relation("OAuthClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  authorizationRequests OAuthAuthorizationRequest[]
  authorizationCodes    OAuthAuthorizationCode[]
  accessTokens          OAuthAccessToken[]
  refreshTokens         OAuthRefreshToken[]
  grants                OAuthGrant[]

  @@index([createdById])
  @@index([tenantId, createdById])
  @@index([tenantId, isActive])
  @@index([isActive])
}

model OAuthAuthorizationRequest {
  id                  String    @id @default(cuid())
  tenantId            String?
  requestId           String    @unique
  clientId            String
  userId              String?
  redirectUri         String    @db.Text
  responseType        String
  scope               String
  state               String?   @db.Text
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  resource            String?   @db.Text
  sessionScope        Json?
  operationAllowlist  Json?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  tenant Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([tenantId, clientId, expiresAt])
  @@index([tenantId, userId, expiresAt])
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  tenantId            String?
  codeHash            String    @unique
  clientId            String
  userId              String
  redirectUri         String    @db.Text
  scope               String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  resource            String?   @db.Text
  grantId             String?
  sessionScope        Json?
  operationAllowlist  Json?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  tenant Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant  OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([grantId])
  @@index([tenantId, clientId, expiresAt])
  @@index([tenantId, userId, expiresAt])
  @@index([tenantId, grantId])
}

model OAuthAccessToken {
  id           String    @id @default(cuid())
  tenantId     String?
  tokenHash    String    @unique
  clientId     String
  userId       String?
  scope        String
  grantType    String
  familyId     String?
  sessionScope Json?
  operationAllowlist Json?
  resource     String?   @db.Text
  grantId      String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  tenant Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant  OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([grantId])
  @@index([familyId])
  @@index([revokedAt])
  @@index([tenantId, clientId, expiresAt])
  @@index([tenantId, userId, expiresAt])
  @@index([tenantId, grantId])
}

model OAuthRefreshToken {
  id           String    @id @default(cuid())
  tenantId     String?
  tokenHash    String    @unique
  clientId     String
  userId       String?
  scope        String
  grantType    String
  sessionScope Json?
  operationAllowlist Json?
  resource     String?   @db.Text
  grantId      String?
  expiresAt    DateTime
  revokedAt    DateTime?
  rotatedAt    DateTime?
  familyId     String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  tenant Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant  OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@index([grantId])
  @@index([familyId])
  @@index([revokedAt])
  @@index([tenantId, clientId, expiresAt])
  @@index([tenantId, userId, expiresAt])
  @@index([tenantId, grantId])
}

model OAuthRateLimitBucket {
  key       String   @id @db.VarChar(255)
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Normalized OAuth grant and per-session capability. The legacy sessionScope
// JSON fields remain temporarily for tokens issued before this migration.
model OAuthGrant {
  id        String    @id @default(cuid())
  tenantId  String?
  clientId  String
  userId    String
  scope     String
  resource  String?   @db.Text
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant              Tenant?                        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  client              OAuthClient                    @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionCapabilities OAuthGrantSessionCapability[]
  authorizationCodes  OAuthAuthorizationCode[]
  accessTokens        OAuthAccessToken[]
  refreshTokens       OAuthRefreshToken[]

  @@index([userId, revokedAt])
  @@index([clientId, revokedAt])
  @@index([tenantId, userId, revokedAt])
  @@index([tenantId, clientId, revokedAt])
}

model OAuthGrantSessionCapability {
  id         String   @id @default(cuid())
  tenantId   String?
  grantId    String
  sessionId  String
  capability String   @db.VarChar(16)
  createdAt  DateTime @default(now())

  tenant  Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  grant   OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  session Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([grantId, sessionId])
  @@index([tenantId, grantId, sessionId])
  @@index([sessionId, capability])
}

model OIDCIdentity {
  id            String   @id @default(cuid())
  provider      String
  subject       String
  userId        String
  email         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([provider, userId])
  @@index([userId])
}

// Broadcast/Blast history & logs
model BroadcastLog {
  id          String    @id @default(cuid())
  tenantId    String?
  sessionId   String // WA session ID string
  message     String    @db.Text
  total       Int
  sent        Int       @default(0)
  failed      Int       @default(0)
  status      String    @default("running") // running, completed, cancelled
  delay       Int       @default(2000)
  claimToken  String?
  claimedAt   DateTime?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  recipients BroadcastRecipient[]

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, sessionId])
  @@index([tenantId, sessionId, startedAt])
  @@index([sessionId])
  @@index([sessionId, startedAt])
  @@index([status, claimedAt])
}

model BroadcastRecipient {
  id             String    @id @default(cuid())
  tenantId       String?
  broadcastLogId String
  jid            String
  status         String    @default("pending") // pending, sent, failed
  error          String?   @db.Text
  sentAt         DateTime?
  claimToken     String?
  claimedAt      DateTime?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?

  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  broadcastLog BroadcastLog @relation(fields: [broadcastLogId], references: [id], onDelete: Cascade)

  @@index([tenantId, broadcastLogId, status])
  @@index([tenantId, status, claimedAt])
  @@index([tenantId, status, nextAttemptAt])
  @@index([broadcastLogId, status])
  @@index([status, claimedAt])
  @@index([status, nextAttemptAt])
}

// Shared send lock and pacing state used by every app replica for one WA session.
model WhatsAppSendThrottle {
  sessionId      String   @id
  tenantId       String?
  nextAllowedAt  DateTime?
  leaseToken     String?
  leaseUntil     DateTime?
  updatedAt      DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, sessionId])
  @@index([leaseUntil])
}

// Distributed ownership lease: at most one application replica may own a
// live Baileys connection for a WhatsApp session at a time.
model WhatsAppSessionLease {
  sessionId    String   @id
  tenantId     String?
  ownerId      String
  leaseToken   String
  fencingToken Int      @default(0)
  leaseUntil   DateTime
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, sessionId])
  @@index([leaseUntil])
  @@index([ownerId])
}


// Durable receipt and outbox record for idempotent text sends.
model OutboundMessageOperation {
  id                    String   @id @default(cuid()) @db.VarChar(191)
  tenantId              String?  @db.VarChar(191)
  userId                String   @db.VarChar(191)
  sessionDbId           String   @db.VarChar(191)
  whatsappSessionId     String   @db.VarChar(191)
  jid                   String   @db.VarChar(255)
  idempotencyKeyHash    String   @db.Char(64)
  requestHash           String   @db.Char(64)
  payload               Json
  status                String   @default("QUEUED") @db.VarChar(32)
  attempts              Int      @default(0)
  availableAt           DateTime @default(now())
  claimToken            String?  @db.VarChar(191)
  claimedAt             DateTime?
  claimExpiresAt        DateTime?
  resultMessageKey      String?  @db.VarChar(191)
  failureCode           String?  @db.VarChar(128)
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([userId, sessionDbId, idempotencyKeyHash], map: "outbound_op_idempotency_uq")
  @@index([status, availableAt], map: "outbound_op_queue_idx")
  @@index([tenantId, sessionDbId, createdAt], map: "outbound_op_tenant_session_idx")
  @@index([tenantId, userId, sessionDbId, createdAt], map: "outbound_op_tenant_user_session_idx")
  @@index([sessionDbId, createdAt], map: "outbound_op_session_idx")
  @@index([userId, sessionDbId, createdAt], map: "outbound_op_user_session_idx")
}
